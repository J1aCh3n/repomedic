diff --git a/task_scheduler/storage.py b/task_scheduler/storage.py
--- a/task_scheduler/storage.py
+++ b/task_scheduler/storage.py
@@ -17,5 +17,10 @@ class InMemoryTaskStore:
     def get(self, task_id: str) -> Task | None:
         return self._tasks.get(task_id)
 
+    def replace(self, task: Task) -> None:
+        if task.task_id not in self._tasks:
+            raise ValueError(f"unknown task: {task.task_id}")
+        self._tasks[task.task_id] = task
+
     def all(self) -> tuple[Task, ...]:
         return tuple(self._tasks.values())
